# Copy to .env (in this folder) and adjust. Every setting can also be set as a plain environment variable.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://smartbudget:smartbudget@localhost:5434/smartbudget
TEST_DATABASE_URL=postgresql+psycopg://smartbudget:smartbudget@localhost:5435/smartbudget_test
# Sign JWTs with this. Generate your own: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-dev-only-secret
# Category suggestions: "none" (default) or "anthropic" (needs ANTHROPIC_API_KEY).
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=
